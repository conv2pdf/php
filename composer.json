{
    "name": "conv2pdf/php",
    "description": "Official PHP SDK for the conv2pdf API: PDF conversion and manipulation, hosted in the EU (France), GDPR-compliant, DPA provided.",
    "type": "library",
    "license": "MIT",
    "keywords": ["pdf", "conversion", "convert", "conv2pdf", "api", "sdk", "rgpd", "gdpr", "docx", "html", "merge"],
    "homepage": "https://conv2pdf.com/api/",
    "support": {
        "docs": "https://conv2pdf.com/api/documentation/",
        "source": "https://github.com/conv2pdf/php"
    },
    "authors": [
        { "name": "Jamal Tantaoui", "homepage": "https://tantaoui.com" }
    ],
    "require": {
        "php": "^8.0",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": { "Conv2pdf\\": "src/" }
    }
}
